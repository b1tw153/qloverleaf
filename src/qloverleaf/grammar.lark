// ======================================================================
// OverpassQL Grammar (Lark)
// Translated from overpassql.ebnf
// ======================================================================

// TOP LEVEL

query: (("[" global_setting "]")+ ";")? statement*

// GLOBAL SETTINGS

global_setting: "timeout" ":" global_timeout
              | "maxsize" ":" global_maxsize
              | "out" ":" global_output
              | "bbox" ":" global_bbox
              | "date" ":" global_date
              | "diff" ":" global_diff
              | "adiff" ":" global_adiff

global_timeout: INTEGER

global_maxsize: INTEGER

global_bbox: number "," number "," number "," number

global_date: DATETIME

global_diff: DATETIME ("," DATETIME)?

global_adiff: DATETIME ("," DATETIME)?

global_output: global_output_xml
             | global_output_json
             | global_output_csv
             | global_output_custom
             | global_output_popup

global_output_xml: "xml"

global_output_json: "json"

global_output_csv: "csv" "(" csv_spec ")"

global_output_custom: "custom"

global_output_popup: "popup" ("(" popup_config ")")?

popup_config: popup_token (";" popup_token)* ";"?
popup_token: (STRING | POPUP_CHARS)*
POPUP_CHARS: /[^;)"']+/

csv_spec: csv_field ("," csv_field)* (";" BOOLEAN (";" STRING)?)?
csv_field: "::" csv_builtin
         | tag_key

csv_builtin: SIMPLE_CSV_BUILTIN | QUOTED_CSV_BUILTIN

SIMPLE_CSV_BUILTIN: "id" | "type" | "otype" | "lat" | "lon"
                    | "version" | "timestamp" | "changeset" | "uid" | "user" | "count"

COMPLEX_CSV_BUILTIN: "count:nodes" | "count:ways" | "count:relations"

// Quoted builtins accept the unquoted names plus the colon-containing count variants
QUOTED_CSV_BUILTIN: "\"" (SIMPLE_CSV_BUILTIN | COMPLEX_CSV_BUILTIN) "\""

// STATEMENTS

statement: simple_stmt ";"
         | block_stmt

?simple_stmt: query_stmt
            | union_stmt
            | item_stmt
            | out_stmt
            | recurse_stmt
            | is_in_stmt
            | timeline_stmt
            | local_stmt
            | convert_stmt
            | make_stmt
            | map_to_area_stmt
            | compare_stmt

?block_stmt: foreach_stmt
           | for_stmt
           | complete_stmt
           | if_stmt
           | retro_stmt

set_assignment: "->" set_ref

// QUERY STATEMENT

query_stmt: element_type filter* set_assignment?

// TODO: covert aliases to productions
element_type: "node"     -> element_type_node
            | "way"      -> element_type_way
            | "rel"      -> element_type_relation
            | "relation" -> element_type_relation
            | "nwr"      -> element_type_nwr
            | "nw"       -> element_type_nw
            | "wr"       -> element_type_wr
            | "nr"       -> element_type_nr
            | "area"     -> element_type_area
            | "derived"  -> element_type_derived

// QUERY FILTERS

?filter: tag_filter
       | bbox_filter
       | id_filter
       | around_set_filter
       | around_point_filter
       | around_line_filter
       | polygon_filter
       | newer_filter
       | changed_filter
       | user_filter
       | uid_filter
       | user_touched_filter
       | uid_touched_filter
       | area_set_filter
       | area_id_filter
       | recurse_filter
       | way_count_filter
       | way_link_filter
       | set_filter
       | pivot_filter
       | if_filter

// TODO: covert aliases to productions
tag_filter: "[" tag_key "]"                                                       -> tag_filter_exists
          | "[" "!" tag_key "]"                                                   -> tag_filter_absent
          | "[" tag_key "=" tag_value "]"                                         -> tag_filter_eq
          | "[" tag_key "!=" tag_value "]"                                        -> tag_filter_neq
          | "[" tag_key "~" tag_value_regex regex_case_insensitive? "]"           -> tag_filter_regex
          | "[" tag_key "!~" tag_value_regex regex_case_insensitive? "]"          -> tag_filter_not_regex
          | "[" "~" tag_key_regex "~" tag_value_regex regex_case_insensitive? "]" -> tag_filter_key_regex

tag_key_regex: STRING
tag_value_regex: STRING
regex_case_insensitive: "," "i"

// Coordinates in bbox_filter are (south, west, north, east)
bbox_filter: "(" number "," number "," number "," number ")"

// TODO: covert aliases to productions
id_filter: "(" INTEGER ")"                                         -> id_filter_single
         | "(" "id" ":" INTEGER ("," INTEGER)* ")"                 -> id_filter_list

// Radius in metres; optional lat/lon pairs define a polyline reference
around_set_filter: "(" "around" set_ref? ":" around_radius ")"
around_point_filter: "(" "around" ":" around_radius "," around_lat_lon ")"
around_line_filter: "(" "around" ":" around_radius "," around_lat_lon "," around_lat_lon ("," around_lat_lon)* ")"

around_radius: UNSIGNED_NUMBER
around_lat_lon: number "," number

polygon_filter: "(" "poly" ":" ( "\"" poly_lat_lon+ "\"" | "'" poly_lat_lon+ "'" ) ")"
poly_lat_lon: number number

newer_filter: "(" "newer" ":" DATETIME ")"

changed_filter: "(" "changed" ":" DATETIME ("," DATETIME)? ")"

user_filter: "(" "user" ":" STRING ("," STRING)* ")"

uid_filter: "(" "uid" ":" INTEGER ("," INTEGER)* ")"

user_touched_filter: "(" "user_touched" ":" STRING ("," STRING)* ")"

uid_touched_filter: "(" "uid_touched" ":" INTEGER ("," INTEGER)* ")"

// Without :integer, uses areas from the input set
area_set_filter: "(" "area" set_ref? ")"
area_id_filter: "(" "area" ":" INTEGER ")"

recurse_filter: "(" RECURSE_TYPE set_ref? (":" recurse_role)? ")"
recurse_role: STRING

way_count_filter: "(" "way_cnt" ":" int_range ")"
way_link_filter:  "(" "way_link" ":" int_range ")"

int_range: INTEGER ("-" INTEGER?)?

set_filter:   "." SET_NAME
pivot_filter: "(" "pivot" set_ref? ")"
if_filter:    "(" "if" ":" evaluator ")"

// BLOCK STATEMENTS

block_body: "{" statement* "}"
          | "(" statement* ")"

foreach_stmt:  "foreach" set_ref? set_assignment? block_body
for_stmt:      "for" set_ref? set_assignment? "(" evaluator ")" block_body
complete_stmt: "complete" set_ref? set_assignment? ("(" INTEGER ")")? "{" statement* "}"
if_stmt:       "if" "(" evaluator ")" block_body ("else" block_body)?
retro_stmt:    "retro" "(" evaluator ")" block_body

// OTHER STATEMENTS

union_stmt:   "(" union_body ")" set_assignment?
union_body:   union_member*
union_member: "-"? statement

item_stmt: set_ref set_assignment?

out_stmt:  set_ref? "out" out_token*
out_token: OUT_VERB | INTEGER | bbox_filter

// >> and << must be listed before > and < so the longer match wins
recurse_stmt: set_ref? RECURSE_DIR set_assignment?
RECURSE_DIR: ">>" | "<<" | ">" | "<"

is_in_stmt: set_ref? "is_in" ("(" number "," number ")")? set_assignment?

timeline_stmt: "timeline" "(" TIMELINE_TYPE "," INTEGER ("," INTEGER)? ")" set_assignment?

local_stmt: set_ref? "local" ("l" | "ll" | "llb")? set_assignment?

convert_stmt: set_ref? "convert" DERIVED_NAME (tag_assignment ("," tag_assignment)*)? set_assignment?
make_stmt:    "make" DERIVED_NAME (tag_assignment ("," tag_assignment)*)? set_assignment?

tag_assignment: "!" tag_key
              | "::id" "=" evaluator
              | "::geom" "=" evaluator
              | "::" "=" evaluator
              | SET_NAME "::" "=" evaluator
              | tag_key "=" evaluator

map_to_area_stmt: set_ref? "map_to_area" set_assignment?

compare_stmt: set_ref? "compare" "(" ("delta" ":" evaluator)? ")" set_assignment? ("{" statement* "}")?

// EVALUATORS

?evaluator: or_expr ("?" or_expr ":" evaluator)?
?or_expr:   and_expr ("||" and_expr)*
?and_expr:  not_expr ("&&" not_expr)*

?not_expr: NOT_OP not_expr
        | compare_expr
NOT_OP: "!"

?compare_expr: add_expr (COMPARE_OP add_expr)?

?add_expr:     mul_expr  ((ADD_OP | SUBTRACT_OP) mul_expr)*
ADD_OP: "+"
SUBTRACT_OP: "-"

?mul_expr:     unary_expr ((MULTIPLY_OP | DIVIDE_OP) unary_expr)*
MULTIPLY_OP: "*"
DIVIDE_OP: "/"

?unary_expr: NEGATE_OP unary_expr
          | primary_expr
NEGATE_OP: "-"

// Aggregator functions optionally qualified with a named set: name.fn(expr)
// TODO: covert aliases to productions
primary_expr: "(" evaluator ")"
            | UNSIGNED_NUMBER
            | STRING
            | "id" "(" ")"                                            -> id_expr
            | "type" "(" ")"                                          -> type_expr
            | "t" "[" evaluator "]"                                   -> tag_value_expr
            | "is_tag" "(" tag_key ")"                                -> is_tag_expr
            | "keys" "(" ")"                                          -> keys_expr
            | "::"                                                    -> generic_tag_expr
            | "version" "(" ")"                                       -> version_expr
            | "timestamp" "(" ")"                                     -> timestamp_expr
            | "changeset" "(" ")"                                     -> changeset_expr
            | "uid" "(" ")"                                           -> uid_expr
            | "user" "(" ")"                                          -> user_expr
            | "count_tags" "(" ")"                                    -> count_tags_expr
            | "count_members" "(" ")"                                 -> count_members_expr
            | "count_distinct_members" "(" ")"                        -> count_distinct_members_expr
            | "count_by_role" "(" evaluator ")"                       -> count_by_role_expr
            | "count_distinct_by_role" "(" evaluator ")"              -> count_distinct_by_role_expr
            | "is_closed" "(" ")"                                     -> is_closed_expr
            | "lat" "(" ")"                                           -> lat_expr
            | "lon" "(" ")"                                           -> lon_expr
            | "geom" "(" ")"                                          -> geom_expr
            | "length" "(" ")"                                        -> length_expr
            | "center" "(" evaluator ")"                              -> center_expr
            | "trace" "(" evaluator ")"                               -> trace_expr
            | "hull" "(" evaluator ")"                                -> hull_expr
            | "pt" "(" evaluator "," evaluator ")"                    -> pt_expr
            | "lstr" "(" evaluator "," evaluator ("," evaluator)* ")" -> lstr_expr
            | "poly" "(" evaluator "," evaluator ("," evaluator)* ")" -> poly_expr
            | "per_member" "(" evaluator ")"                          -> per_member_expr
            | "per_vertex" "(" evaluator ")"                          -> per_vertex_expr
            | "pos" "(" ")"                                           -> pos_expr
            | "mtype" "(" ")"                                         -> mtype_expr
            | "ref" "(" ")"                                           -> ref_expr
            | "role" "(" ")"                                          -> role_expr
            | "angle" "(" ")"                                         -> angle_expr
            | "number" "(" evaluator ")"                              -> number_expr
            | "date" "(" evaluator ")"                                -> date_expr
            | "suffix" "(" evaluator ")"                              -> suffix_expr
            | "abs" "(" evaluator ")"                                 -> abs_expr
            | "is_number" "(" evaluator ")"                           -> is_number_expr
            | "is_date" "(" evaluator ")"                             -> is_date_expr
            | (set_name ".")? "u" "(" evaluator ")"                   -> union_expr
            | (set_name ".")? "min" "(" evaluator ")"                 -> min_expr
            | (set_name ".")? "max" "(" evaluator ")"                 -> max_expr
            | (set_name ".")? "sum" "(" evaluator ")"                 -> sum_expr
            | (set_name ".")? "set" "(" evaluator ")"                 -> set_expr
            | (set_name ".")? "gcat" "(" evaluator ")"                -> gcat_expr
            | (set_name ".")? "count" "(" COUNT_TYPE ")"              -> count_expr
            | "lrs_in" "(" evaluator "," evaluator ")"                -> lrs_in_expr
            | "lrs_isect" "(" evaluator "," evaluator ")"             -> lrs_isect_expr
            | "lrs_union" "(" evaluator "," evaluator ")"             -> lrs_union_expr
            | "lrs_min" "(" evaluator ")"                             -> lrs_min_expr
            | "lrs_max" "(" evaluator ")"                             -> lrs_max_expr
            | set_name "." "val"                                      -> val_expr

// SET REFERENCES

set_name: SET_NAME
set_ref: "." SET_NAME

tag_key:   STRING | UNQUOTED_KEY
tag_value: STRING | UNQUOTED_VALUE
number:    NUMBER

// TERMINALS

// Identifiers — same character class, context distinguishes usage
SET_NAME:     /[A-Za-z_][A-Za-z0-9_]*/
DERIVED_NAME: /[A-Za-z][A-Za-z0-9_]*/
UNQUOTED_KEY: /[A-Za-z_][A-Za-z0-9_]*/

// Tag values allow only alphanumerics and underscore when unquoted
UNQUOTED_VALUE: /[A-Za-z0-9_]+/

// String literals: double- or single-quoted with backslash escapes
STRING: /\"([^\"\\]|\\[nt\"'\\]|\\u[0-9A-Fa-f]{4})*\"/
      | /\'([^\'\\]|\\[nt\"'\\]|\\u[0-9A-Fa-f]{4})*\'/

BOOLEAN: "true" | "false"

INTEGER: /[0-9]+/

// Signed decimal for coordinates; unsigned for radii and evaluator literals
NUMBER:          /[+-]?([0-9]+(\.[0-9]*)?|[0-9]*\.[0-9]+)([eE][+-]?[0-9]+)?/
UNSIGNED_NUMBER: /([0-9]+(\.[0-9]*)?|[0-9]*\.[0-9]+)([eE][+-]?[0-9]+)?/

// ISO 8601 UTC datetime, always quoted: "YYYY-MM-DDTHH:mm:ssZ"
// TODO: permit single quoted datetime values in the EBNF
_DATETIME_BODY: /[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z/
DATETIME: "\"" _DATETIME_BODY "\"" | "'" _DATETIME_BODY "'"

// bn/bw/br before w/r so longer tokens match first
RECURSE_TYPE: "bn" | "bw" | "br" | "w" | "r"

// <= and >= before < and > so longer tokens match first
COMPARE_OP: "==" | "!=" | "<=" | ">=" | "<" | ">"

COUNT_TYPE: "nodes" | "ways" | "relations" | "deriveds" | "nwr" | "nw" | "wr" | "nr"

OUT_VERB: "ids" | "skel" | "body" | "tags" | "meta" | "count"
        | "geom" | "bb" | "center" | "noids" | "asc" | "qt"

TIMELINE_TYPE: "node" | "way" | "relation"

// IGNORED TOKENS

%ignore /[ \t\n\r]+/
%ignore /\/\/.*/
%ignore /\/\*([^*]|\*[^\/])*\*\//
