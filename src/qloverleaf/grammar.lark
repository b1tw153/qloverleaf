// ======================================================================
// OverpassQL Grammar (Lark)
// Translated from overpassql.ebnf
// ======================================================================

// TOP LEVEL

query: (("[" global_setting "]")+ ";")? statement*

// GLOBAL SETTINGS

global_setting: "timeout" ":" INTEGER
              | "maxsize" ":" INTEGER
              | "out" ":" output_format
              | "bbox" ":" number "," number "," number "," number
              | "date" ":" DATETIME
              | "diff" ":" DATETIME ("," DATETIME)?
              | "adiff" ":" DATETIME ("," DATETIME)?

output_format: "xml"
             | "json"
             | "csv" "(" csv_spec ")"
             | "custom"
             | "popup" ("(" popup_config ")")?

popup_config: popup_token (";" popup_token)* ";"?
popup_token: (STRING | POPUP_CHARS)*
POPUP_CHARS: /[^;)"']+/

csv_spec: csv_field ("," csv_field)* (";" BOOLEAN (";" STRING)?)?
csv_field: "::" UNQUOTED_CSV_BUILTIN
         | "::" STRING
         | tag_key

// Longer variants listed first so the lexer prefers them over plain builtins
UNQUOTED_CSV_BUILTIN: "count:nodes" | "count:ways" | "count:relations" | "count:areas"
                    | "id" | "type" | "otype" | "lat" | "lon"
                    | "version" | "timestamp" | "changeset" | "uid" | "user" | "count"

// STATEMENTS

statement: simple_stmt ";"
         | block_stmt

?simple_stmt: query_stmt
            | union_stmt
            | item_stmt
            | out_stmt
            | recurse_stmt
            | is_in_stmt
            | timeline_stmt
            | local_stmt
            | convert_stmt
            | make_stmt
            | map_to_area_stmt
            | compare_stmt

?block_stmt: foreach_stmt
           | for_stmt
           | complete_stmt
           | if_stmt
           | retro_stmt

// QUERY STATEMENT

query_stmt: element_type filter* ("->" set_ref)?

element_type: "node" | "way" | "rel" | "relation"
            | "nwr" | "nw" | "wr" | "nr"
            | "area" | "derived"

// QUERY FILTERS

?filter: tag_filter
       | bbox_filter
       | id_filter
       | around_filter
       | polygon_filter
       | newer_filter
       | changed_filter
       | user_filter
       | area_filter
       | recurse_filter
       | way_count_filter
       | way_link_filter
       | set_filter
       | pivot_filter
       | if_filter

tag_filter: "[" tag_key "]"                                        -> tag_exists
          | "[" "!" tag_key "]"                                    -> tag_absent
          | "[" tag_key "=" tag_value "]"                          -> tag_eq
          | "[" tag_key "!=" tag_value "]"                         -> tag_neq
          | "[" tag_key "~" STRING ("," "i")? "]"                  -> tag_regex
          | "[" tag_key "!~" STRING ("," "i")? "]"                 -> tag_not_regex
          | "[" "~" STRING "~" STRING ("," "i")? "]"               -> tag_key_regex

// Coordinates in bbox_filter are (south, west, north, east)
bbox_filter: "(" number "," number "," number "," number ")"

id_filter: "(" INTEGER ")"                                         -> id_single
         | "(" "id" ":" INTEGER ("," INTEGER)* ")"                -> id_list

// Radius in metres; optional lat/lon pairs define a polyline reference
around_filter: "(" "around" set_ref? ":" UNSIGNED_NUMBER ("," number "," number ("," number "," number)*)? ")"

polygon_filter: "(" "poly" ":" STRING ")"

newer_filter: "(" "newer" ":" DATETIME ")"

changed_filter: "(" "changed" ":" DATETIME ("," DATETIME)? ")"

user_filter: "(" "user" ":" STRING ("," STRING)* ")"
           | "(" "uid" ":" INTEGER ("," INTEGER)* ")"
           | "(" "user_touched" ":" STRING ("," STRING)* ")"
           | "(" "uid_touched" ":" INTEGER ("," INTEGER)* ")"

// Without :integer, uses areas from the input set
area_filter: "(" "area" set_ref? (":" INTEGER)? ")"

recurse_filter: "(" RECURSE_TYPE set_ref? (":" STRING)? ")"

way_count_filter: "(" "way_cnt" ":" int_range ")"
way_link_filter:  "(" "way_link" ":" int_range ")"

int_range: INTEGER ("-" INTEGER?)?

set_filter:   "." SET_NAME
pivot_filter: "(" "pivot" set_ref? ")"
if_filter:    "(" "if" ":" evaluator ")"

// BLOCK STATEMENTS

block_body: "{" statement* "}"
          | "(" statement* ")"

foreach_stmt:  "foreach" set_ref? ("->" set_ref)? block_body
for_stmt:      "for" set_ref? ("->" set_ref)? "(" evaluator ")" block_body
complete_stmt: "complete" set_ref? ("->" set_ref)? ("(" INTEGER ")")? "{" statement* "}"
if_stmt:       "if" "(" evaluator ")" block_body ("else" block_body)?
retro_stmt:    "retro" "(" evaluator ")" block_body

// OTHER STATEMENTS

union_stmt:   "(" union_body ")" ("->" set_ref)?
union_body:   union_member*
union_member: "-"? statement

item_stmt: set_ref ("->" set_ref)?

out_stmt:  set_ref? "out" out_token*
out_token: OUT_VERB | INTEGER | bbox_filter

// >> and << must be listed before > and < so the longer match wins
recurse_stmt: set_ref? RECURSE_DIR ("->" set_ref)?
RECURSE_DIR: ">>" | "<<" | ">" | "<"

is_in_stmt: set_ref? "is_in" ("(" number "," number ")")? ("->" set_ref)?

timeline_stmt: "timeline" "(" TIMELINE_TYPE "," INTEGER ("," INTEGER)? ")" ("->" set_ref)?

local_stmt: set_ref? "local" ("l" | "ll" | "llb")? ("->" set_ref)?

convert_stmt: set_ref? "convert" DERIVED_NAME (tag_assignment ("," tag_assignment)*)? ("->" set_ref)?
make_stmt:    "make" DERIVED_NAME (tag_assignment ("," tag_assignment)*)? ("->" set_ref)?

tag_assignment: "!" tag_key
              | "::id" "=" evaluator
              | "::geom" "=" evaluator
              | "::" "=" evaluator
              | SET_NAME "::" "=" evaluator
              | tag_key "=" evaluator

map_to_area_stmt: set_ref? "map_to_area" ("->" set_ref)?

compare_stmt: set_ref? "compare" "(" ("delta" ":" evaluator)? ")" ("->" set_ref)? ("{" statement* "}")?

// EVALUATORS

?evaluator: ternary_expr

ternary_expr: or_expr ("?" or_expr ":" ternary_expr)?
or_expr:      and_expr ("||" and_expr)*
and_expr:     not_expr ("&&" not_expr)*

not_expr: "!" not_expr
        | compare_expr

compare_expr: add_expr (COMPARE_OP add_expr)?
add_expr:     mul_expr  (("+" | "-") mul_expr)*
mul_expr:     unary_expr (("*" | "/") unary_expr)*

unary_expr: "-" unary_expr
          | primary_expr

// Aggregator functions optionally qualified with a named set: .name.fn(expr)
// set_ref is "." SET_NAME, so (set_ref ".")? expands to ("." SET_NAME ".")?
primary_expr: "(" evaluator ")"
            | UNSIGNED_NUMBER
            | STRING
            | "id" "(" ")"
            | "type" "(" ")"
            | "t" "[" evaluator "]"
            | "is_tag" "(" tag_key ")"
            | "keys" "(" ")"
            | "::"
            | "version" "(" ")"
            | "timestamp" "(" ")"
            | "changeset" "(" ")"
            | "uid" "(" ")"
            | "user" "(" ")"
            | "count_tags" "(" ")"
            | "count_members" "(" ")"
            | "count_distinct_members" "(" ")"
            | "count_by_role" "(" evaluator ")"
            | "count_distinct_by_role" "(" evaluator ")"
            | "is_closed" "(" ")"
            | "lat" "(" ")"
            | "lon" "(" ")"
            | "geom" "(" ")"
            | "length" "(" ")"
            | "center" "(" evaluator ")"
            | "trace" "(" evaluator ")"
            | "hull" "(" evaluator ")"
            | "pt" "(" evaluator "," evaluator ")"
            | "lstr" "(" evaluator "," evaluator ("," evaluator)* ")"
            | "poly" "(" evaluator "," evaluator ("," evaluator)* ")"
            | "per_member" "(" evaluator ")"
            | "per_vertex" "(" evaluator ")"
            | "pos" "(" ")"
            | "mtype" "(" ")"
            | "ref" "(" ")"
            | "role" "(" ")"
            | "angle" "(" ")"
            | "number" "(" evaluator ")"
            | "date" "(" evaluator ")"
            | "suffix" "(" evaluator ")"
            | "abs" "(" evaluator ")"
            | "is_number" "(" evaluator ")"
            | "is_date" "(" evaluator ")"
            | (set_ref ".")? "u" "(" evaluator ")"
            | (set_ref ".")? "min" "(" evaluator ")"
            | (set_ref ".")? "max" "(" evaluator ")"
            | (set_ref ".")? "sum" "(" evaluator ")"
            | (set_ref ".")? "set" "(" evaluator ")"
            | (set_ref ".")? "gcat" "(" evaluator ")"
            | (set_ref ".")? "count" "(" COUNT_TYPE ")"
            | "lrs_in" "(" evaluator "," evaluator ")"
            | "lrs_isect" "(" evaluator "," evaluator ")"
            | "lrs_union" "(" evaluator "," evaluator ")"
            | "lrs_min" "(" evaluator ")"
            | "lrs_max" "(" evaluator ")"
            | set_ref "." "val"

// SET REFERENCES

set_ref: "." SET_NAME

tag_key:   STRING | UNQUOTED_KEY
tag_value: STRING | UNQUOTED_VALUE
number:    "-"? UNSIGNED_NUMBER

// TERMINALS

// Identifiers — same character class, context distinguishes usage
SET_NAME:     /[A-Za-z_][A-Za-z0-9_]*/
DERIVED_NAME: /[A-Za-z][A-Za-z0-9_]*/
UNQUOTED_KEY: /[A-Za-z_][A-Za-z0-9_]*/

// Tag values allow only alphanumerics and underscore when unquoted
UNQUOTED_VALUE: /[A-Za-z0-9_]+/

// String literals: double- or single-quoted with backslash escapes
STRING: /\"([^\"\\]|\\[nt\"'\\]|\\u[0-9A-Fa-f]{4})*\"/
      | /\'([^\'\\]|\\[nt\"'\\]|\\u[0-9A-Fa-f]{4})*\'/

BOOLEAN: "true" | "false"

INTEGER: /[0-9]+/

// Signed decimal for coordinates; unsigned for radii and evaluator literals
NUMBER:          /[+-]?([0-9]+(\.[0-9]*)?|[0-9]*\.[0-9]+)([eE][+-]?[0-9]+)?/
UNSIGNED_NUMBER: /([0-9]+(\.[0-9]*)?|[0-9]*\.[0-9]+)([eE][+-]?[0-9]+)?/

// ISO 8601 UTC datetime, always quoted: "YYYY-MM-DDTHH:mm:ssZ"
DATETIME: /\"[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z\"/

// bn/bw/br before w/r so longer tokens match first
RECURSE_TYPE: "bn" | "bw" | "br" | "w" | "r"

// <= and >= before < and > so longer tokens match first
COMPARE_OP: "==" | "!=" | "<=" | ">=" | "<" | ">"

COUNT_TYPE: "nodes" | "ways" | "relations" | "deriveds" | "nwr" | "nw" | "wr" | "nr"

OUT_VERB: "ids" | "skel" | "body" | "tags" | "meta" | "count"
        | "geom" | "bb" | "center" | "noids" | "asc" | "qt"

TIMELINE_TYPE: "node" | "way" | "relation"

// IGNORED TOKENS

%ignore /[ \t\n\r]+/
%ignore /\/\/.*/
%ignore /\/\*([^*]|\*[^\/])*\*\//
